{
  // 거산리프트 홈페이지 — Cloudflare 설정
  "name": "shiny-snowflake-f1df",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    // /api/, 사진, 주요 페이지만 서버 코드가 처리하고, 나머지(그림·디자인 파일)는 정적 파일을 바로 보여줌
    "run_worker_first": ["/api/*", "/photos/*", "/", "/index.html", "/case", "/case.html", "/cases", "/cases.html", "/robots.txt", "/sitemap.xml"]
  },
  "vars": {
    "NOTIFY_EMAIL": "gslift2020@naver.com"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "gslift-db",
      "database_id": "94697a8c-fbf0-4309-a1a6-f1cbd3bca4cf"
    }
  ],
  "r2_buckets": [
    {
      "binding": "PHOTOS",
      "bucket_name": "gslift-photos"
    }
  ],
  "observability": { "enabled": true }
}
